# Documentation only. Django does not automatically load this file.
# Set a freshly generated DJANGO_SECRET_KEY in your process environment.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
PGDATABASE=ucc_dev
PGUSER=ucc_dev
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=prefer
# Separate disposable database; test role must be allowed to create it.
PGTESTDATABASE=test_ucc

# Milestone 2B: private random hex key (at least 32 bytes), NOT Django's secret.
# Provision the same key in the database; never commit a populated copy.
UCC_CONTEXT_SIGNING_KEY=
# Used by migrator-only configure_runtime; application PGUSER must be runtime.
UCC_RUNTIME_ROLE=ucc_runtime
# Security tests only: separate roles/passwords and disposable scratch database.
UCC_RUNTIME_PASSWORD=
UCC_MIGRATION_ROLE=ucc_migrator_test
UCC_MIGRATION_PASSWORD=
UCC_SECURITY_SCRATCH_DATABASE=ucc_security_scratch
# Set to 1 only against an explicitly disposable test cluster.
UCC_DISPOSABLE_TEST_CLUSTER=0

# Milestone 3: distinct restricted account/session role (never the migrator).
UCC_AUTH_ROLE=ucc_auth
UCC_AUTH_PASSWORD=
# Web: PGUSER/PGPASSWORD must refer to academic runtime; use auth_development locally.
# Do not put DBA/migrator credentials in a web process.
