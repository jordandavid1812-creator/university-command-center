# Vercel receives only what the website needs: vercel_app.py, pyproject.toml, uv.lock,
# .python-version, academic_logic.py and server/ (without its tests).
/*
!/vercel_app.py
!/pyproject.toml
!/uv.lock
!/.python-version
!/academic_logic.py
!/server/
/server/*_tests/
/server/**/tests/
**/__pycache__/
**/*.pyc
