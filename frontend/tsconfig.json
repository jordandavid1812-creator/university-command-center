{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "removeComments": false,
    "newLine": "lf",
    "outDir": "../server/student_web/static/student_web",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
